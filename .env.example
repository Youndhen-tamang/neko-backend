# Server
PORT=4000
NODE_ENV=development
FRONTEND_STORE_URL=http://localhost:3000
FRONTEND_SUPER_ADMIN_URL=http://localhost:3004

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_WORKSPACE_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Super admin
SUPER_ADMIN_LOGIN_EMAIL=
SUPER_ADMIN_PASS=
JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# OpenRouter
OPENROUTER_API_KEY=

# WhatsApp Cloud API (per-store phone number id + access token are set in /admin/settings)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Key used to encrypt stored integration tokens (falls back to JWT_SECRET). Changing it invalidates stored tokens.
INTEGRATION_SECRET_KEY=

# Virtual try-on image model (OpenRouter)
TRYON_MODEL=google/gemini-2.5-flash-image
