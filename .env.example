# Server
# Development: localhost values below are the defaults when a variable is missing.
# Production (NODE_ENV=production): FRONTEND_STORE_URL, FRONTEND_SUPER_ADMIN_URL,
# DATABASE_URL, JWT_SECRET, SUPER_ADMIN_LOGIN_EMAIL and SUPER_ADMIN_PASS are required
# and the two frontend URLs must not point at localhost. The app refuses to boot otherwise.
PORT=4000
NODE_ENV=development
FRONTEND_STORE_URL=http://localhost:3000
FRONTEND_SUPER_ADMIN_URL=http://localhost:3004
# Public base URL of this API (used for the WhatsApp webhook URL shown in settings)
PUBLIC_API_URL=http://localhost:4000

# Production example (Render + Vercel). Leave PORT unset on Render; it is injected.
# NODE_ENV=production
# FRONTEND_STORE_URL=https://yourdomain.com          # stores live on https://{slug}.yourdomain.com
# FRONTEND_SUPER_ADMIN_URL=https://neko-superadmin.vercel.app
# PUBLIC_API_URL=https://neko-backend.onrender.com

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_WORKSPACE_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Super admin
SUPER_ADMIN_LOGIN_EMAIL=
SUPER_ADMIN_PASS=
JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# OpenRouter
OPENROUTER_API_KEY=

# WhatsApp Cloud API (per-store phone number id + access token are set in /admin/settings)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Key used to encrypt stored integration tokens (falls back to JWT_SECRET). Changing it invalidates stored tokens.
INTEGRATION_SECRET_KEY=

# Virtual try-on image model (OpenRouter)
TRYON_MODEL=google/gemini-2.5-flash-image

# Shop assistant voice (one voice for the whole storefront; no browser fallback)
# Create a key at https://elevenlabs.io → Developers → API keys
# Use a premade voice id. Library/community voices return 402 on the free plan.
# Rachel (female): 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
